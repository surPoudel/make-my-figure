{
  "plot_type": "kaplan_meier_survival_curve",
  "input_table": "heart_km.csv",
  "mapping": {
    "time": "time_months",
    "event": "event",
    "group": "group"
  },
  "journal_style": "publication",
  "output": {
    "formats": [
      "svg",
      "png",
      "pdf"
    ],
    "width_mm": 89.0,
    "height_mm": 70.0,
    "dpi": 300
  },
  "layout": {
    "column_width": "onehalf",
    "x_label": "Time (months)",
    "y_label": "Survival probability",
    "title": "Stanford heart transplant survival by age group",
    "legend_outside": true
  },
  "statistics": {
    "enabled": true,
    "test": "logrank",
    "comparison_mode": "all_pairs"
  }
}