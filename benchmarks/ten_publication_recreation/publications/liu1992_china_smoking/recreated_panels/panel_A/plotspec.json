{
  "plot_type": "forest_plot",
  "input_table": "china_forest.csv",
  "mapping": {
    "label": "subgroup",
    "estimate": "odds_ratio",
    "lower": "ci_low",
    "upper": "ci_high",
    "reference": 1.0,
    "log_scale": true
  },
  "journal_style": "publication",
  "output": {
    "formats": [
      "svg",
      "png",
      "pdf"
    ],
    "width_mm": 89.0,
    "height_mm": 70.0,
    "dpi": 300
  },
  "layout": {
    "column_width": "onehalf",
    "x_label": "Odds ratio (smoking, lung cancer)",
    "title": "Smoking-lung cancer OR by city",
    "legend_outside": true
  }
}