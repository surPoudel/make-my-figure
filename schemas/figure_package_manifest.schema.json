{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makemyfigure.org/schemas/figure_package_manifest.schema.json",
  "title": "MakeMyFigure Portable Figure Package manifest",
  "description": "manifest.json at the root of a .mmfpackage container. Lists every file with its SHA-256, the specifications, the frozen tables, the assets and the environment used to create the figure.",
  "type": "object",
  "required": ["package_format", "format_version", "created_with", "created_at", "figure_kind", "name", "specs", "components", "tables", "files", "privacy_notice"],
  "additionalProperties": true,
  "properties": {
    "package_format": {"const": "make_my_figure.figure_package"},
    "format_version": {"type": "integer", "minimum": 1},
    "created_with": {
      "type": "object",
      "required": ["application", "version"],
      "properties": {
        "application": {"type": "string"},
        "version": {"type": "string"},
        "commit": {"type": ["string", "null"]}
      }
    },
    "created_at": {"type": "string"},
    "figure_kind": {"enum": ["single_plot", "composite"]},
    "name": {"type": "string"},
    "privacy_notice": {"type": "string"},
    "specs": {
      "type": "object",
      "description": "Root-level specification files present in the package (internal paths).",
      "properties": {
        "plot_spec": {"type": "string"},
        "stats_spec": {"type": "string"},
        "matrix_spec": {"type": "string"},
        "sample_metadata_spec": {"type": "string"},
        "preprocessing_spec": {"type": "string"},
        "figure_spec": {"type": "string"}
      },
      "additionalProperties": {"type": "string"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "kind"],
        "properties": {
          "component_id": {"type": "string"},
          "kind": {"enum": ["plot", "make_my_figure_panel", "external_figure_panel"]},
          "label": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "plot_type": {"type": ["string", "null"]},
          "plot_spec": {"type": ["string", "null"]},
          "stats_spec": {"type": ["string", "null"]},
          "table_id": {"type": ["string", "null"]},
          "aux_tables": {"type": "object", "additionalProperties": {"type": "string"}},
          "asset": {"type": ["string", "null"]},
          "width_in": {"type": ["number", "null"]},
          "height_in": {"type": ["number", "null"]}
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table_id", "role", "path", "sha256", "bytes", "n_rows", "n_columns", "columns"],
        "properties": {
          "table_id": {"type": "string"},
          "role": {"enum": ["source_table", "derived_table", "aux_table", "metadata_table"]},
          "path": {"type": "string"},
          "encoding": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer"},
          "content_digest": {"type": "string"},
          "n_rows": {"type": "integer"},
          "n_columns": {"type": "integer"},
          "columns": {"type": "array", "items": {"type": "string"}},
          "dtypes": {"type": "object"},
          "n_missing": {"type": "integer"},
          "display_name": {"type": ["string", "null"]},
          "derived_from": {"type": ["string", "null"]},
          "csv_copy": {"type": ["string", "null"]},
          "original_file": {
            "type": ["object", "null"],
            "properties": {
              "path": {"type": ["string", "null"]},
              "filename": {"type": "string"},
              "sha256": {"type": ["string", "null"]},
              "bytes": {"type": ["integer", "null"]},
              "sheet_name": {"type": ["string", "null"]},
              "header_row": {"type": ["integer", "null"]},
              "included": {"type": "boolean"},
              "note": {"type": ["string", "null"]}
            }
          },
          "provenance": {"type": "object"}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "path", "sha256", "bytes"],
        "properties": {
          "asset_id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "bytes": {"type": "integer"},
          "original_filename": {"type": ["string", "null"]},
          "media_type": {"type": ["string", "null"]},
          "component_id": {"type": ["string", "null"]}
        }
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "format"],
        "properties": {"path": {"type": "string"}, "format": {"type": "string"}, "dpi": {"type": ["integer", "null"]}}
      }
    },
    "files": {
      "type": "array",
      "description": "Integrity list: every member of the container except manifest.json.",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "role"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer"},
          "role": {"type": "string"}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to"],
        "properties": {"type": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "via": {"type": ["string", "null"]}}
      }
    },
    "environment": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "compatibility": {
      "type": "object",
      "properties": {
        "min_reader_format_version": {"type": "integer"},
        "reader_must_verify_checksums": {"type": "boolean"},
        "features": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
