{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MakeMyFigure Plot Specification",
  "type": "object",
  "required": [
    "plot_type",
    "input_table",
    "mapping",
    "journal_style",
    "output"
  ],
  "properties": {
    "plot_type": {
      "type": "string"
    },
    "input_table": {
      "type": "string"
    },
    "mapping": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null",
          "array"
        ]
      }
    },
    "column_annotations": {
      "type": "array"
    },
    "annotations": {
      "type": "array",
      "description": "Universal manual annotation layer (v0.5); list of AnnotationSpec objects."
    },
    "statistics": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "description": "Optional worksheet provenance when the data came from a multi-sheet Excel workbook (workbook name/hash, sheet name/index/type, header row). Absent for CSV/TSV/single-table sources.",
      "properties": {
        "source_workbook_name": {"type": "string"},
        "source_workbook_hash": {"type": "string"},
        "source_sheet_name": {"type": "string"},
        "source_sheet_index": {"type": "integer"},
        "source_sheet_type": {"type": "string"},
        "source_header_row": {"type": ["integer", "null"]}
      }
    },
    "journal_style": {
      "type": "string"
    },
    "layout": {
      "type": "object"
    },
    "output": {
      "type": "object",
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "svg",
              "pdf",
              "png",
              "tiff",
              "eps"
            ]
          }
        },
        "width_mm": {
          "type": "number"
        },
        "height_mm": {
          "type": "number"
        },
        "dpi": {
          "type": "integer"
        }
      }
    }
  }
}