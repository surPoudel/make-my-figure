{
  "plot_type": "kaplan_meier_survival_curve",
  "input_table": "data.csv",
  "mapping": {
    "time": "time_months",
    "event": "event",
    "group": "group"
  },
  "journal_style": "publication",
  "output": {
    "formats": [
      "svg",
      "png",
      "pdf"
    ],
    "width_mm": 89.0,
    "height_mm": 70.0,
    "dpi": 300
  },
  "statistics": {
    "enabled": true,
    "test": "logrank",
    "comparison_mode": "auto",
    "correction": "none",
    "alpha": 0.05,
    "alternative": "two-sided",
    "posthoc": false,
    "posthoc_test": "welch_t",
    "value_column": null,
    "group_column": "group",
    "subgroup_column": null,
    "subject_column": null,
    "time_column": "time_months",
    "event_column": "event",
    "x_column": null,
    "y_column": null,
    "row_column": null,
    "col_column": null,
    "reference_group": null,
    "selected_pairs": null,
    "annotate": true,
    "annotation": {
      "mode": "stars",
      "digits": 3,
      "sci_threshold": 0.001,
      "show_effect": false,
      "show_nonsignificant": true,
      "font_size": null,
      "line_width": null,
      "bracket_height_frac": 0.03,
      "gap_frac": 0.06,
      "top_margin_frac": 0.12
    }
  }
}