{
  "plot_type": "boxplot_or_violin_with_points",
  "input_table": "data.csv",
  "mapping": {
    "x": "dose_group",
    "y": "measurement",
    "kind": "box"
  },
  "journal_style": "publication",
  "output": {
    "formats": [
      "svg",
      "png",
      "pdf"
    ],
    "width_mm": 89.0,
    "height_mm": 70.0,
    "dpi": 300
  },
  "statistics": {
    "enabled": true,
    "test": "one_way_anova",
    "comparison_mode": "all_pairs",
    "correction": "benjamini_hochberg",
    "alpha": 0.05,
    "alternative": "two-sided",
    "posthoc": true,
    "posthoc_test": "welch_t",
    "value_column": null,
    "group_column": null,
    "subgroup_column": null,
    "subject_column": null,
    "time_column": null,
    "event_column": null,
    "x_column": null,
    "y_column": null,
    "row_column": null,
    "col_column": null,
    "reference_group": null,
    "selected_pairs": null,
    "annotate": true,
    "annotation": {
      "mode": "stars",
      "digits": 3,
      "sci_threshold": 0.001,
      "show_effect": false,
      "show_nonsignificant": true,
      "font_size": null,
      "line_width": null,
      "bracket_height_frac": 0.03,
      "gap_frac": 0.06,
      "top_margin_frac": 0.12
    }
  }
}