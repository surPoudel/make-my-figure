.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.egg-info/
build/
dist/
*.log
*.tmp

# Local editor / tool config (not part of the project)
.claude/
.idea/
.vscode/

# Harvested third-party paper/figure library — kept LOCAL-ONLY.
# It contains figure captions/metadata extracted from open-access (CC BY) papers.
# To avoid any third-party redistribution question, the whole library is excluded
# from the repo. Regenerate locally with: python scripts/harvest_library.py
# (see docs/REPO_EXCLUSIONS.md).
figure_library/
# PyInstaller / packaging artifacts
*.spec.bak
*.AppDir/
*.iconset/

# Generated QA gallery / large outputs (regenerate via scripts/). Keep the small
# markdown QC audit reports tracked; ignore the large image/vector artifacts.
outputs/**/*.png
outputs/**/*.svg
outputs/**/*.pdf
outputs/**/*.tif
outputs/**/*.tiff
reports/*.png
reports/example_figures/*.png
reports/example_figures/*.svg
reports/example_figures/*.plot_spec.json
# Publication QC gallery: keep qc_summary.csv + qc_report.md, ignore the images.
reports/publication_qc_gallery/per_plot/
reports/publication_qc_gallery/*.png
reports/publication_qc_gallery/*.pdf

# Generated statistics-example figures are reproducible from scripts/ — keep the
# data/spec/README text in-repo, exclude any rendered images.
examples/statistics/**/*.png
examples/statistics/**/*.pdf
examples/statistics/**/*.svg

# Harvested figure library: keep provenance/metadata JSON + license.txt in-repo,
# but do not commit the downloaded figure bitmaps / supplementary binaries in bulk.
figure_library/**/figures/*.jpg
figure_library/**/figures/*.jpeg
figure_library/**/figures/*.png
figure_library/**/figures/*.gif
figure_library/**/supplementary/*
figure_library/**/full_text/*

# Private user workbooks / uploads dropped at the repo root (never commit real data).
# Synthetic test fixtures live under examples/ and are committed explicitly.
/*.xlsx
/*.xls
/*.xlsm

# Private user outputs / screenshots dropped at the repo root (never commit).
/*.png
/Screenshot*.png

# Manuscript work stays LOCAL — never commit it to the software repository.
manuscript/
prompts/
REFERENCE_AND_OUTLINE_AUDIT.md
scripts/*_manuscript*.py
scripts/*manuscript*.py
benchmarks/r_validation/results/R/*.rds

# PDF build cache for the manuals (regenerated by scripts/build_manuals.py)
docs/manuals/assets/_pdf_cache/

# Local assistant prompt files are not part of the public repository
claude_code/
benchmarks/r_validation/reports/METHODS_FOR_MANUSCRIPT.md
CLAUDE.md

# Private diagnostic notes about a collaborator's workbooks stay local
reports/collaborator_concerns/

# Build and Release Manager agent: local build staging and per-run reports (never committed)
release_staging/
.agents/makemyfigure-release-manager/reports/
